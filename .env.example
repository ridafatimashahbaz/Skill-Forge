# Copy this file to .env and fill in real values before running docker compose.

# Secret used to sign JWTs. Use a long random string in real deployments.
JWT_SECRET=change-me-to-a-random-string

# Get a key from https://console.anthropic.com/ — required for the AI service
# (RAG chat and the career-planning agent). Without it, everything except the
# AI assistant tab will still work.
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-6
